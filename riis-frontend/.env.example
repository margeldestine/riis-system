# VITE_API_BASE_URL -- the riis-backend base URL this frontend talks to.
#
# IMPORTANT: Vite inlines VITE_-prefixed env vars into the JavaScript
# bundle at BUILD time, not read at runtime -- setting this on a running
# server has no effect. It must be set correctly BEFORE running
# `npm run build` (or `vite build`) for each environment (dev/staging/
# prod), typically via your CI/CD pipeline's environment configuration
# or a local .env file that is never committed.
#
# If unset, apiClient.js and SubmissionPortal.jsx fall back to
# http://localhost:8080/api/v1, so local development needs no .env file
# at all unless you're pointing at a non-default local backend port.
#
# Example values:
#   Local dev:   http://localhost:8080/api/v1
#   Staging:     https://staging-api.dasig.dost7.gov.ph/api/v1
#   Production:  https://api.dasig.dost7.gov.ph/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1